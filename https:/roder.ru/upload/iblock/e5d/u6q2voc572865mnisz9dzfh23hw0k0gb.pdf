<script>
        $(document).on('submit', 'form.modal-callback', function(){
            var $form = $(this);
            $.post($form.attr('action'), $form.serialize(), function(data){
                $('input', $form).removeAttr('disabled');

                if (data.type == 'error') {
                    $form.find(".message").removeClass("success-message");
                    $form.find(".message").addClass("error-message");
                    $form.find(".message").html(data.message);
                } else {
                    $form.find(".message").addClass("success-message");
                    $form.find(".message").removeClass("error-message");
                    $form.find(".message").html(data.message);

                    $form.find("input").not(':input[type=button], :input[type=submit], :input[type=hidden]').val('');
                    $form.find("textarea").val('');
                    window.location.href = "/forma1/success.php";
                }
            }, 'json');
            return false;
        });
    </script>
